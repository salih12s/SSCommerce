# Yerel geliştirme şablonu. Gerçek sır içermez.
# Kopyala:  Copy-Item .env.example .env   (sonra parolayı değiştir)
# docker compose bu dosyayı değil, .env dosyasını okur.

POSTGRES_DB=sscommerce
POSTGRES_USER=sscommerce
POSTGRES_PASSWORD=change-me-local-only
# Host portu. Yerel PostgreSQL 5432'yi kullanıyorsa 5433 kalsın (DECISIONS D-007).
POSTGRES_PORT=5433
