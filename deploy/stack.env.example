# Üretim-eşdeğeri yığın şablonu. Sır İÇERMEZ (yer tutucu). Kopyala: deploy/.env.stack (Git dışı; `.env.*` kuralı yoksayar)
# ya da rastgele sırlar üretmek için: sh deploy/scripts/gen-env.sh
POSTGRES_DB=sscommerce
PG_SUPERUSER=ssc_pgadmin
PG_SUPERUSER_PASSWORD=change-me
SSC_OWNER_PASSWORD=change-me
SSC_APP_PASSWORD=change-me
SSC_BACKUP_PASSWORD=change-me

# Tarayıcının gördüğü köken (CSRF origin kontrolü ve çerez kapsamı). Yerel doğrulama: https://localhost:8443
SSC_PUBLIC_ORIGIN=https://localhost:8443
EDGE_SITE=localhost
HSTS_MAX_AGE=300

# Sürüm damgası (imaj etiketi + OCI etiketleri). Üretimde etiket/commit kısa SHA.
SSC_VERSION=local
SSC_GIT_SHA=unknown

# Sipariş verme: sahip iş-riski kararına kadar KAPALI (D-072). Yalnız yalıtılmış sınama yığınında true.
ORDERING_ENABLED=false
